{
  "name": "geodle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev",
    "prod": "node build.mjs build",
    "build": "npm run generate-prod && dotenv -e .env.prod -- next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "validate-env-dev": "dotenv -e .env.dev -- node validateEnv.mjs",
    "validate-env-prod": "dotenv -e .env.prod -- node validateEnv.mjs",
    "deploy-dev": "dotenv -e .env.dev -- npx prisma db push --force-reset && dotenv -e .env.dev -- npx prisma db seed && npm run generate-dev && dotenv -e .env.dev -- tsx generateCountryGraph.ts",
    "deploy-prod": "dotenv -e .env.prod -- npx prisma db push --force-reset && dotenv -e .env.prod -- npx prisma db seed && npm run generate-prod && dotenv -e .env.prod -- tsx generateCountryGraph.ts",
    "generate-dev": "dotenv -e .env.dev -- npx prisma generate && dotenv -e .env.dev -- npm run generate-value-types",
    "generate-prod": "dotenv -e .env.prod -- npx prisma generate && dotenv -e .env.prod -- npm run generate-value-types",
    "generate-value-types": "tsx prisma/generators/genRegions.ts",
    "generate-geojson": "tsx generateGeoJson.ts",
    "generate-dev-country-graph": "dotenv -e .env.dev -- tsx generateCountryGraph.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mapbox/geo-viewport": "^0.5.0",
    "@next/env": "^16.4.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/mapbox__geo-viewport": "^0.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "react": "^19.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "three-globe": "^2.45.6",
    "unidecode": "^1.1.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unidecode": "^1.1.0",
    "cli-progress": "^3.12.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "geojson-places": "^1.0.8",
    "graph-data-structure": "^3.5.0",
    "mapshaper": "^0.7.99",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "sass": "^1.106.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
