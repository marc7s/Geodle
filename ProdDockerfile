### BUILD STAGE ###
FROM node:24 AS build

WORKDIR /usr/app

# Install dependencies, including the dev dependencies the build needs (e.g. mapshaper and tsx)
COPY package*.json /usr/app/
RUN npm ci

# Copy the app
COPY . /usr/app

# The environment variables come from .env.prod in the build context (see .env.prod.example)
# Fail early if any required variable is missing
RUN npm run validate-env-prod

# The database, generated types and map outlines are not in the repository, so they are created here
RUN npm run deploy-prod
RUN npm run generate-geojson

# Build the static site into /usr/app/out
RUN npm run build

### RUN STAGE ###
# Only the static files are served, there is no backend
FROM nginx:bookworm
COPY --from=build /usr/app/out /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
